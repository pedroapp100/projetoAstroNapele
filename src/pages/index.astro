---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Protocol from '../components/Protocol.astro';
import Treatments from '../components/Treatments.astro';
import Clinic from '../components/Clinic.astro';
import Results from '../components/Results.astro';
import Doctor from '../components/Doctor.astro';
import Faq from '../components/Faq.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Napele Clínica | Estética facial e corporal em Anápolis">
  <Header />

  <main class="elementor elementor-11" data-elementor-type="wp-page" data-elementor-id="11">
    <Hero />
    <Marquee />
    <Protocol />
    <Treatments />
    <Clinic />
    <Results />
    <Doctor />
    <Faq />
    <Visit />
  </main>

  <Footer />
</Layout>
