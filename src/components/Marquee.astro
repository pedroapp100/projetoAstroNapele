---
// Marquee.astro
// Faixa dourada contínua de tratamentos Napele (Ato 1 -> Ato 2)
// Desliza suavemente a 40px/s com pausa ao hover e separador estrelado dourado
---
<section class="np-marquee" aria-label="Tratamentos da Napele">
  <div class="np-marquee__viewport">
    <ul class="np-marquee__list">
      <li>Toxina botulínica</li>
      <li>Preenchimento com ácido hialurônico</li>
      <li>Fios de PDO</li>
      <li>Intradermoterapia</li>
      <li>Bioestimuladores</li>
      <li>Tratamento de microvasos</li>
      <li>Lipoenzimática de papada</li>
      <li>Limpeza de pele</li>
      <li>Microagulhamento</li>
      <li>Skinbooster</li>
      <li>Drenagem linfática</li>
      <li>Massagem modeladora</li>
      <li>Hidratação e regeneração labial</li>
    </ul>
  </div>
</section>


