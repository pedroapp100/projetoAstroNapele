---
// Layout fiel ao Overview do design system: o <head> e a cadeia de scripts seguem a ordem exata de
// design-sistem-napele/assets/overview/index.html (linhas 51–134 e 926–981). Nada aqui sobrescreve o napele.css.
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import WhatsappFloat from '../components/WhatsappFloat.astro';

interface Props {
  title?: string;
  description?: string;
  /** 'home' (padrão): o Overview. 'treatment': a página-modelo de tratamento (sem pré-loader, só os scripts dela). */
  variant?: 'home' | 'treatment';
  /** slug do tratamento (vai para body[data-treatment], como no napele-treatment.js) */
  treatment?: string;
}

const {
  title = 'Napele Clínica | Estética facial e corporal em Anápolis',
  description = 'Napele Clínica, em Anápolis (GO): estética facial e corporal com avaliação individual, tratamentos feitos sob medida e uma equipe que explica cada etapa.',
  variant = 'home',
  treatment,
} = Astro.props;
const isTreatment = variant === 'treatment';

const O = '/assets/overview/';

// A Vercel entrega tudo em /assets/ com `max-age=31536000, immutable` (um ano) e sem versão na URL: quem já visitou o site continuava com o CSS e o JS antigos.
// `?v=<hash do conteúdo>` muda o endereço quando o arquivo muda, então qualquer visitante baixa a versão nova na visita seguinte (o HTML é sempre revalidado).
// Sem cache em memória: no `dev` o arquivo pode mudar entre uma página e outra; são poucos arquivos pequenos.
// Quem lê `script.src` (preloader, tiles, contact) não se afeta: `new URL(relativo, src)` ignora a query, e o contact a descarta com `.*$`.
function ver(file: string): string {
  const hash = createHash('sha1').update(readFileSync(join(process.cwd(), 'public/assets', file))).digest('hex');
  return `?v=${hash.slice(0, 8)}`;
}

// As duas configs inline do Elementor vêm do próprio index.html (fonte única, sem cópia que se desatualize);
// só as URLs relativas ganham o prefixo /assets/overview/, porque aqui a página fica em "/".
const overviewHtml = readFileSync(join(process.cwd(), 'public/assets/overview/index.html'), 'utf8');
function elementorConfig(name: string): string {
  const start = overviewHtml.indexOf(`var ${name} = `);
  const end = overviewHtml.indexOf(';\n', start);
  return overviewHtml
    .slice(start, end + 1)
    .replace(/"(wp-content|wp-admin|wp-json|wp-includes)\\\//g, '"/assets/overview/$1\\/');
}

// index.html linhas 26–50: estilos inline do WordPress (entre eles `:where(body){margin:0}`, que zera a margem do body)
function inlineStyle(id: string): string {
  const m = overviewHtml.match(new RegExp(`<style id="${id}"[^>]*>([\\s\\S]*?)</style>`));
  return m ? m[1] : '';
}
const wordpressStyles = ['wp-img-auto-sizes-contain-inline-css', 'wp-emoji-styles-inline-css', 'global-styles-inline-css'];

// index.html linhas 51–71, na mesma ordem
const styles = [
  'wp-content/themes/hello-elementor/style.css',
  'wp-content/themes/hello-elementor-child/style.css',
  'wp-content/plugins/elementor/assets/css/frontend.min.css',
  'wp-content/plugins/elementor/assets/css/widget-image.min.css',
  'wp-content/plugins/elementor-pro/assets/css/widget-nav-menu.min.css',
  'wp-content/plugins/elementor/assets/css/widget-social-icons.min.css',
  'wp-content/plugins/elementor/assets/css/conditionals/apple-webkit.min.css',
  'wp-content/plugins/elementor-pro/assets/css/modules/sticky.min.css',
  'wp-content/plugins/elementor/assets/css/widget-image-box.min.css',
  'wp-content/plugins/elementor/assets/css/widget-heading.min.css',
  'wp-content/plugins/elementor/assets/css/widget-icon-list.min.css',
  'wp-content/uploads/elementor/css/post-6.css',
  'wp-content/plugins/elementor/assets/lib/animations/styles/e-animation-float.min.css',
  'wp-content/cache/min/1/wp-content/plugins/elementor/assets/lib/swiper/v8/css/swiper.min.css',
  'wp-content/plugins/elementor/assets/css/conditionals/e-swiper.min.css',
  'wp-content/plugins/elementor-pro/assets/css/widget-nested-carousel.min.css',
  'wp-content/plugins/elementor/assets/css/widget-video.min.css',
  'wp-content/plugins/elementor/assets/css/widget-star-rating.min.css',
  'wp-content/cache/background-css/nudik.com.br/wp-content/uploads/elementor/css/post-11.css',
  'wp-content/uploads/elementor/css/post-14.css',
  'wp-content/cache/background-css/nudik.com.br/wp-content/uploads/elementor/css/post-28.css',
];

// tratamento.html (head): a mesma base, sem o carrossel/vídeo/estrelas da home, com icon-box, accordion e o CSS da página 825
const treatmentStyles = [
  ...styles.slice(0, 12), // até post-6.css
  'wp-content/plugins/elementor/assets/css/widget-icon-box.min.css',
  'wp-content/plugins/elementor/assets/css/widget-nested-accordion.min.css',
  'wp-content/cache/background-css/nudik.com.br/wp-content/uploads/elementor/css/post-11.css',
  'wp-content/cache/background-css/nudik.com.br/wp-content/uploads/elementor/css/post-825.css',
  'wp-content/uploads/elementor/css/post-14.css',
  'wp-content/cache/background-css/nudik.com.br/wp-content/uploads/elementor/css/post-28.css',
];

// index.html linhas 926–958 (a cadeia do Elementor, que o WP Rocket carregava em atraso): mesma ordem, defer
const elementorChain = [
  'wp-content/plugins/elementor/assets/js/webpack.runtime.min.js',
  'wp-content/plugins/elementor/assets/js/frontend-modules.min.js',
  'wp-includes/js/jquery/ui/core.min.js',
  'wp-content/plugins/elementor/assets/js/frontend.min.js',
  'wp-content/plugins/elementor-pro/assets/lib/smartmenus/jquery.smartmenus.min.js',
  'wp-content/plugins/elementor-pro/assets/lib/sticky/jquery.sticky.min.js',
  'wp-content/plugins/elementor/assets/lib/swiper/v8/swiper.min.js',
  'wp-content/plugins/elementor-pro/assets/js/webpack-pro.runtime.min.js',
  'wp-includes/js/dist/hooks.min.js',
  'wp-includes/js/dist/i18n.min.js',
  'wp-content/plugins/elementor-pro/assets/js/frontend.min.js',
  'wp-content/plugins/elementor-pro/assets/js/elements-handlers.min.js',
];

// index.html linhas 972–981: os scripts do design system, cada um UMA vez
const napeleScripts = [
  'napele-tiles.js',
  'napele-nav.js',
  'napele-marquee.js',
  'napele-procedures.js',
  'napele-results.js',
  'napele-faq.js',
  'napele-contact.js',
  'napele-clinic.js',
  'napele-clinic-gallery.js',
  'napele-reveal.js',
];

// tratamento.html (fim do body): só estes três scripts do design system (a navbar vem do catálogo, no design system)
const treatmentScripts = ['napele-tiles.js', 'napele-nav.js', 'napele-contact.js'];

// index.html linhas 72–96
const fontsCss = `
@font-face { font-family: 'aeonik'; font-style: normal; font-weight: normal; font-display: auto; src: url('${O}wp-content/uploads/2024/12/Aeonik_OVERVIEW-Regular.woff2') format('woff2'); }
@font-face { font-family: 'aeonik'; font-style: normal; font-weight: 500; font-display: auto; src: url('${O}wp-content/uploads/2024/12/Aeonik_OVERVIEW-Medium.woff2') format('woff2'); }
@font-face { font-family: 'aeonik'; font-style: normal; font-weight: 700; font-display: auto; src: url('${O}wp-content/uploads/2024/12/Aeonik_OVERVIEW-Bold.woff2') format('woff2'); }
`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Napele Clínica" />
    <link rel="icon" href={`${O}wp-content/uploads/2024/09/napele-icon-32x32.webp`} sizes="32x32" />
    <link rel="icon" href={`${O}wp-content/uploads/2024/09/napele-icon-192x192.webp`} sizes="192x192" />
    <link rel="apple-touch-icon" href={`${O}wp-content/uploads/2024/09/napele-icon-180x180.webp`} />

    {wordpressStyles.map((id) => <style is:inline set:html={inlineStyle(id)}></style>)}
    {(isTreatment ? treatmentStyles : styles).map((href) => <link rel="stylesheet" href={O + href} />)}
    <style is:inline set:html={fontsCss}></style>

    <!-- Fundamentos Napele: tokens, cores, textura e seções. Carregado por último para vencer o kit do Elementor -->
    <link rel="stylesheet" href={`/assets/napele.css${ver('napele.css')}`} />
    {!isTreatment && <link rel="stylesheet" href={`/assets/napele-preloader.css${ver('napele-preloader.css')}`} />}
    <script is:inline src={`/assets/napele-site.js${ver('napele-site.js')}`}></script>
    {!isTreatment && <script is:inline src="/assets/vendor/gsap.min.js"></script>}
    {!isTreatment && <script is:inline src={`/assets/napele-preloader.js${ver('napele-preloader.js')}`}></script>}
  </head>
  <body
    class={isTreatment
      ? 'np-treatment wp-singular page-template page-template-elementor_header_footer page page-id-825 wp-embed-responsive wp-theme-hello-elementor wp-child-theme-hello-elementor-child hello-elementor-default elementor-default elementor-template-full-width elementor-kit-6 elementor-page elementor-page-825'
      : 'home wp-singular page-template page-template-elementor_header_footer page page-id-11 wp-embed-responsive wp-theme-hello-elementor wp-child-theme-hello-elementor-child hello-elementor-default elementor-default elementor-template-full-width elementor-kit-6 elementor-page elementor-page-11 np-pre-hold'}
    data-view={isTreatment ? 'tratamentos' : 'overview'}
    data-treatment={treatment}
  >
    <!-- Ícones (sprite do design system) -->
    <svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="np-i-instagram" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r=".9" fill="currentColor" stroke="none"/></symbol><symbol id="np-i-whatsapp" viewBox="0 0 24 24"><path d="M3.2 20.8l1.5-4.3A8.8 8.8 0 1 1 7.7 19.4l-4.5 1.4z"/><path d="M9.3 8.1c-.6.1-1.2.7-1.2 1.5 0 3.1 2.7 5.9 5.8 6.1.8.1 1.5-.5 1.6-1.2 0-.3-.1-.5-.4-.6l-1.5-.7c-.2-.1-.5-.1-.6.1l-.5.6c-.1.1-.3.2-.5.1-.9-.4-1.7-1.2-2.1-2.1-.1-.2-.1-.4.1-.5l.5-.5c.2-.2.2-.4.1-.6l-.7-1.5c-.1-.3-.3-.4-.6-.4z"/></symbol><symbol id="np-i-pin" viewBox="0 0 24 24"><path d="M12 21.5s-6.8-5.6-6.8-11.3a6.8 6.8 0 1 1 13.6 0C18.8 15.9 12 21.5 12 21.5z"/><circle cx="12" cy="10.2" r="2.5"/></symbol></svg>

    <slot />

    <!-- Botão flutuante do WhatsApp (o número vem de napele-contact.js, via data-np-contact) -->
    <WhatsappFloat />

    <!-- Elementor: scripts SÍNCRONOS, em ordem, antes do DOMContentLoaded. Com `defer`, o jQuery dispara o "ready" por timer
         entre um script e outro; se o Elementor Pro demora a baixar, o Elementor inicializa antes de o Pro registrar o
         carrossel e o Swiper nunca nasce (um card gigante). O original controla a ordem com o carregador do WP Rocket. -->
    <script is:inline src={`${O}wp-includes/js/jquery/jquery.min.js`}></script>
    <script is:inline src={`${O}wp-includes/js/jquery/jquery-migrate.min.js`}></script>
    <script is:inline set:html={elementorConfig('elementorFrontendConfig')}></script>
    <script is:inline set:html={elementorConfig('ElementorProFrontendConfig')}></script>
    <script is:inline>window.addEventListener('DOMContentLoaded', function () { jQuery.uiBackCompat = true; });</script>
    {elementorChain.map((src) => <script is:inline src={O + src}></script>)}
    <script is:inline>window.addEventListener('DOMContentLoaded', function () { wp.i18n.setLocaleData({ 'text direction\u0004ltr': ['ltr'] }); });</script>
    {(isTreatment ? treatmentScripts : napeleScripts).map((src) => <script is:inline src={`/assets/${src}${ver(src)}`}></script>)}
  </body>
</html>
